{
  "schema_version": "1.0.0",
  "adopted": "2026-11-15",
  "policy": "pricing/PRICE_DATA_POLICY.md",
  "price_snapshot_row": {
    "type": "object",
    "required": ["market_id", "game_id", "season", "week", "market_type", "market_side", "price", "price_format", "fetched_at_utc", "source_id", "licence_id", "capture_hash"],
    "properties": {
      "market_id": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{1,2}-[A-Z]{2,3}@[A-Z]{2,3}-(side|total|moneyline)(-[A-Za-z0-9]+)?$"},
      "game_id": {"type": "string"},
      "season": {"type": "integer"},
      "week": {"type": "integer"},
      "market_type": {"type": "string", "enum": ["side", "total", "moneyline"]},
      "market_side": {"type": "string", "description": "which side of the market the quote is for: the team abbreviation, 'over'/'under', or 'home'/'away' for moneyline"},
      "price": {"type": "number", "description": "the quoted number itself (American or decimal per price_format; total carries the total line as its price)"},
      "price_format": {"type": "string", "enum": ["american", "decimal", "line"]},
      "price_as_of": {"type": "string", "description": "the source's own timestamp for the quote; blank string when the source gives none"},
      "fetched_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
      "phase": {"type": "string", "enum": ["open", "close", "intraday"]},
      "source_id": {"type": "string"},
      "licence_id": {"type": "string"},
      "capture_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
      "supersedes": {"type": "string", "description": "market_id/fetched_at_utc of a corrected row; empty on first capture"}
    }
  },
  "residual_row": {
    "type": "object",
    "required": ["run_id", "run_at_utc", "game_id", "market_id", "our_fair_line", "market_line", "difference", "our_line_ref", "market_source_id", "licence_id"],
    "properties": {
      "run_id": {"type": "string"},
      "run_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
      "game_id": {"type": "string"},
      "market_id": {"type": "string"},
      "our_fair_line": {"type": "string", "description": "our originated number, with its model version"},
      "market_line": {"type": "string", "description": "the licensed market number at run time"},
      "difference": {"type": "string", "description": "market_line minus our_fair_line, same units"},
      "our_line_ref": {"type": "string", "description": "model version + inputs reference"},
      "market_source_id": {"type": "string"},
      "licence_id": {"type": "string"}
    }
  },
  "originated_market_row": {
    "type": "object",
    "required": ["market_id", "game_id", "season", "week", "market_type", "originated_at_utc", "our_fair_line", "inputs_ref"],
    "properties": {
      "market_id": {"type": "string"},
      "game_id": {"type": "string"},
      "season": {"type": "integer"},
      "week": {"type": "integer"},
      "market_type": {"type": "string", "enum": ["side", "total", "moneyline"]},
      "originated_at_utc": {"type": "string"},
      "our_fair_line": {"type": "string"},
      "inputs_ref": {"type": "string", "description": "probability plus its inputs reference (never a bare pick)"}
    }
  }
}
